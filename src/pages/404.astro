---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="ページが見つかりません (404) | うなぎちゃん公式サイト"
  description="お探しのページは移動または削除された可能性があります。"
>
  <div class="container error-container">
    <div class="cyber-card error-card">
      <span class="error-code gradient-text">404</span>
      <h1 class="error-title">PAGE NOT FOUND</h1>
      <p class="error-desc">
        お探しのページは移動または削除されたか、URLが正しくない可能性があります。
      </p>
      <div class="error-actions">
        <a href="/" class="cyber-btn cyber-btn-primary">
          <span>公式サイトトップへ戻る</span>
        </a>
        <a href="/tools" class="cyber-btn cyber-btn-secondary">
          <span>制作ツール一覧</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .error-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem;
  }

  .error-card {
    padding: 4rem 2rem;
    text-align: center;
    max-width: 540px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .error-code {
    font-size: 5rem;
    font-family: var(--font-mono);
    font-weight: 800;
    line-height: 1;
  }

  .error-title {
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    color: #fff;
  }

  .error-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
</style>
