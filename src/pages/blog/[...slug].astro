---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.pubDate);

const shareUrl = Astro.url.href;
const shareText = encodeURIComponent(`${post.data.title} | うなぎちゃん公式サイト`);
const xShareLink = `https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(shareUrl)}&via=UnagiChaaaaaN`;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
>
  <article class="article-page">
    <div class="article-header">
      <div class="container-narrow">
        <a href="/blog" class="back-link">
          <svg class="back-arrow" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          <span>ブログ一覧へ戻る</span>
        </a>

        <div class="article-meta">
          <time datetime={post.data.pubDate.toISOString()} class="date-badge">
            <svg class="cal-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
            </svg>
            公開日: {formattedDate}
          </time>
          {post.data.tags.map((tag: string) => (
            <span class="cyber-badge">#{tag}</span>
          ))}
        </div>

        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-desc">{post.data.description}</p>
      </div>
    </div>

    <div class="container-narrow article-body-container">
      <!-- Main Prose Content -->
      <div class="prose">
        <Content />
      </div>

      <!-- Share Buttons -->
      <div class="share-box">
        <span class="share-title">この記事をシェアする</span>
        <div class="share-buttons">
          <a
            href={xShareLink}
            target="_blank"
            rel="noopener noreferrer"
            class="cyber-btn cyber-btn-primary share-x-btn"
          >
            <svg class="x-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span>X (Twitter) でポスト</span>
          </a>
        </div>
      </div>

      <!-- Tool Promo Banner -->
      <div class="cyber-card article-tool-promo">
        <div class="promo-text">
          <span class="cyber-badge pink">RECOMMENDED TOOL</span>
          <h3>LINEスタンプ制作なら「StampCreator」</h3>
          <p>
            スマホで撮った写真や描いたイラストをアップロードするだけ。
            規格準拠の余白・サイズ調整・ZIP一括出力をブラウザ完結で行える無料Webツールです。
          </p>
        </div>
        <a
          href="https://stampcreator.unagichan.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="cyber-btn cyber-btn-primary"
        >
          使ってみる (無料)
        </a>
      </div>

      <!-- Author Bio Box -->
      <div class="cyber-card author-box">
        <div class="author-avatar">
          <svg viewBox="0 0 64 64" fill="none" class="avatar-svg">
            <circle cx="32" cy="32" r="30" fill="#0b0f19" stroke="#00f0ff" stroke-width="2"/>
            <path d="M18 42C16 35 22 28 28 26C36 23 44 26 46 34C48 40 43 46 36 46C29 46 25 41 26 36C27 32 32 30 35 32" stroke="#00f0ff" stroke-width="5" stroke-linecap="round"/>
            <circle cx="25" cy="27" r="2.5" fill="#00f0ff"/>
            <circle cx="22" cy="30" r="1.5" fill="#ec4899"/>
          </svg>
        </div>
        <div class="author-info">
          <div class="author-name-row">
            <span class="author-name">うなぎちゃん</span>
            <a
              href="https://x.com/UnagiChaaaaaN"
              target="_blank"
              rel="noopener noreferrer"
              class="author-x"
            >
              @UnagiChaaaaaN
            </a>
          </div>
          <p class="author-bio">
            個人Webツール開発者。クリエイターの作業を快適にするアプリ（StampCreatorなど）の開発や、Web技術・制作ノウハウを発信しています。
          </p>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .article-page {
    padding-bottom: 5rem;
  }

  .article-header {
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
    background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(0, 240, 255, 0.08), transparent 70%);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--cyan);
  }

  .back-arrow {
    width: 16px;
    height: 16px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .date-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .cal-icon {
    width: 15px;
    height: 15px;
    color: var(--cyan);
  }

  .article-title {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.35;
    color: #fff;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 2.75rem;
    }
  }

  .article-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .article-body-container {
    padding-top: 2.5rem;
  }

  /* Share Box */
  .share-box {
    margin: 3rem 0;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .share-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .share-buttons {
    display: flex;
    gap: 1rem;
  }

  .share-x-btn {
    font-size: 0.9rem;
  }

  .x-icon {
    width: 15px;
    height: 15px;
  }

  /* Promo Banner */
  .article-tool-promo {
    margin: 3rem 0;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    border-color: rgba(236, 72, 153, 0.3);
  }

  @media (min-width: 640px) {
    .article-tool-promo {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .promo-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .promo-text h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
  }

  .promo-text p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 480px;
  }

  /* Author Box */
  .author-box {
    margin: 3rem 0;
    padding: 1.75rem;
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .author-avatar {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
  }

  .avatar-svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 10px rgba(0, 240, 255, 0.3));
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .author-name-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-name {
    font-weight: 700;
    font-size: 1.1rem;
    color: #fff;
  }

  .author-x {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--cyan);
  }

  .author-x:hover {
    text-decoration: underline;
  }

  .author-bio {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
