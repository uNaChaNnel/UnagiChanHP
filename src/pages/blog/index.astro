---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 全タグをユニーク抽出
const allTags = Array.from(new Set(posts.flatMap(p => p.data.tags)));
---

<Layout
  title="公式ブログ | うなぎちゃん公式サイト"
  description="うなぎちゃんの公式ブログ。LINEスタンプ制作のノウハウ、Webツール開発記、CloudflareやAstroによるモダンフロントエンド開発Tipsを公開しています。"
>
  <div class="page-header">
    <div class="container">
      <span class="cyber-badge purple">BLOG &amp; INSIGHTS</span>
      <h1 class="page-title">公式ブログ・開発ノート</h1>
      <p class="page-desc">
        LINEスタンプ制作の実践知識、Webフロントエンド技術、個人ツールのUI/UX設計など、
        クリエイターとエンジニアに役立つ知見や、開発で得たノウハウを発信しています。
      </p>

      {allTags.length > 0 && (
        <div class="tag-cloud">
          <span class="tag-label">TAGS:</span>
          {allTags.map((tag) => (
            <span class="tag-pill">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="container blog-main-container">
    <!-- note Feature Banner -->
    <a href="https://note.com/un4chan" target="_blank" rel="noopener noreferrer" class="cyber-card note-feature-banner">
      <div class="note-banner-left">
        <span class="cyber-badge green">NOTE OFFICIAL // 記事準備中</span>
        <h2 class="note-banner-heading">公式note（うなぎちゃん＠）開設！記事は現在鋭意準備中です</h2>
        <p class="note-banner-text">
          「嫁にグラボを一蹴されたプロ駄作クリエーターの収益化奮闘記」や開発ログを執筆中。ページは公開中ですのでフォローしてお待ちください！
        </p>
      </div>
      <div class="note-banner-btn">
        <span class="cyber-btn cyber-btn-primary">noteページへ ➔</span>
      </div>
    </a>

    <div class="blog-grid">
      {sortedPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </div>
</Layout>

<style>
  .page-header {
    padding: 4.5rem 0 3rem;
    border-bottom: 1px solid var(--border-subtle);
    background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(139, 92, 246, 0.08), transparent 70%);
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
    color: #fff;
  }

  .page-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 680px;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .tag-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--cyan);
    letter-spacing: 0.08em;
  }

  .tag-pill {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-full);
  }

  .blog-main-container {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .note-feature-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 2.5rem;
    border-left: 4px solid #10b981;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(14, 20, 36, 0.8) 100%);
    transition: all 0.3s ease;
  }

  .note-feature-banner:hover {
    border-color: #34d399;
    box-shadow: 0 10px 30px rgba(16, 185, 129, 0.2);
    transform: translateY(-2px);
  }

  .note-banner-left {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .note-banner-heading {
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.4;
  }

  .note-banner-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .note-banner-btn {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .note-feature-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.5rem;
    }
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
