---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { toolsData } from '../../data/tools';
---

<Layout
  title="制作ツール一覧 | うなぎちゃん公式サイト"
  description="うなぎちゃんが開発・提供しているクリエイター支援Webツールの一覧。スマホ完結LINEスタンプ制作ツール「StampCreator」をはじめ、登録不要・ブラウザ完結のツールを提供しています。"
>
  <div class="page-header">
    <div class="container">
      <span class="cyber-badge pink">TOOLS DIRECTORY</span>
      <h1 class="page-title">制作ツール・Webアプリ一覧</h1>
      <p class="page-desc">
        クリエイターが創作活動に集中できるよう、面倒な規格調整や画像処理を自動化するWebツールを開発・公開しています。
        すべてのツールはインストール不要、スマホやPCのブラウザからすぐにご利用いただけます。
      </p>
    </div>
  </div>

  <div class="container tools-main-container">
    <div class="tools-grid">
      {toolsData.map((tool) => (
        <ToolCard tool={tool} featured={tool.status === 'active'} />
      ))}
    </div>
  </div>
</Layout>

<style>
  .page-header {
    padding: 4.5rem 0 3rem;
    border-bottom: 1px solid var(--border-subtle);
    background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(236, 72, 153, 0.08), transparent 70%);
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
    color: #fff;
  }

  .page-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 680px;
    line-height: 1.8;
  }

  .tools-main-container {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
