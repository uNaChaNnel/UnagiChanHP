---
import Layout from '../layouts/Layout.astro';
import { toolsData } from '../data/tools';

const featuredTool = toolsData[0];
const noteUrl = "https://note.com/un4chan";
const tweetSupportUrl = "https://x.com/intent/tweet?text=%40UnagiChaaaaaN%20%E3%81%8A%E3%81%98%E3%81%95%E3%82%93%E6%96%B0%E3%81%97%E3%81%84%E3%82%B0%E3%83%A9%E3%83%9C%E8%B2%B7%E3%81%A3%E3%81%A6%E3%82%82%E3%82%89%E3%81%88%EF%BC%81%20%E5%AB%81%E3%81%95%E3%82%93%E8%A8%B1%E3%81%97%E3%81%A6%E3%81%82%E3%81%92%E3%81%A6%EF%BC%81%20https%3A%2F%2Funagichan.com";
---

<Layout
  title="UNAGI Enterprise OS 2.4 | 次世代クラウドインフラ（※中身はうなぎちゃんの自作ツール）"
  description="UNAGI Enterprise OS 2.4 — 次世代クラウドインフラに見せかけて、すべてのソリューションがうなぎちゃんと個人の開発プロダクトに集約されている狂気のポートフォリオ。グラボほちい・・・泥水啜って頑張ります。"
  compactFooter={true}
>
  <!-- Global System Telemetry Bar (Linear / Stripe style status) -->
  <aside class="enterprise-telemetry-bar" aria-label="UNAGI Enterprise リアルタイム稼働テレメトリ">
    <div class="telemetry-inner">
      <div class="telemetry-status-group">
        <span class="status-pulse-dot"></span>
        <span class="telemetry-label">UNAGI Enterprise OS v2.4</span>
        <span class="telemetry-pill live">OPERATIONAL</span>
      </div>
      <div class="telemetry-metrics">
        <span class="metric-segment">
          <span class="m-key">UPTIME</span>
          <span class="m-val text-success">99.99%</span>
        </span>
        <span class="telemetry-sep">/</span>
        <span class="metric-segment">
          <span class="m-key">VRAM ALLOCATION</span>
          <span class="m-val text-alert">0.01% [CRITICAL]</span>
        </span>
        <span class="telemetry-sep">/</span>
        <span class="metric-segment">
          <span class="m-key">WIFE DEFENSE</span>
          <span class="m-val text-danger">99,999 [IRON WALL]</span>
        </span>
        <span class="telemetry-sep">/</span>
        <span class="metric-segment">
          <span class="m-key">BOREDOM TOLERANCE</span>
          <span class="m-val">0.00% [KILL IMMEDIATELY]</span>
        </span>
        <span class="telemetry-sep">/</span>
        <span class="metric-segment cli-hint">
          <span class="m-key">CLI SHORTCUT</span>
          <span class="m-val">Type <code>unagi</code></span>
        </span>
      </div>
    </div>
  </aside>

  <!-- Zero-Scroll Enterprise Cockpit -->
  <div class="enterprise-viewport" id="enterpriseViewport">
    <!-- Ambient Conic Spotlight & Linear Grid -->
    <div class="spotlight-layer" aria-hidden="true"></div>
    <div class="linear-grid-bg" aria-hidden="true"></div>

    <!-- Background Unagi Character Backdrop (Cardの後ろにうっすら配置 / Unveil Modeで全面表示) -->
    <div class="unagi-backdrop-layer" id="unagiBackdrop" aria-hidden="true">
      <div class="unagi-backdrop-glow"></div>
      <img src="/unagi-bg.png" alt="うなぎちゃん" class="unagi-backdrop-img" width="706" height="1024" />

      <!-- 股間の光っている部分にジャスト配置される RESTORE UI ボタン -->
      <div class="groin-restore-wrapper">
        <button id="restoreUiBtn" class="restore-ui-btn groin-btn" type="button" aria-label="元のカードUIを復元">
          <span class="groin-rainbow-pulse"></span>
          <span class="restore-icon">↺</span>
          <span class="restore-text">RESTORE UI</span>
        </button>
      </div>
    </div>

    <!-- Unveil Mode Floating Controls (下端メッセージボックス) -->
    <div class="unveil-controls" id="unveilControls" aria-hidden="true">
      <div class="unveil-banner">
        <span class="unveil-title">うなぎちゃん（真の姿）が顕現しました</span>
      </div>
    </div>

    <div class="container enterprise-container">
      <div class="bento-layout" id="bentoLayout">

        <!-- PRIMARY HERO BENTO: Core Engine & Mission Control -->
        <section class="bento-card hero-bento" aria-label="UNAGI Core Platform">
          <div class="card-glass-shine"></div>
          
          <div class="hero-top-row">
            <div class="enterprise-badge-pill">
              <span class="badge-sparkle">✦</span>
              <span class="badge-text">Next-Gen Cloud Infrastructure</span>
              <span class="badge-divider"></span>
              <span class="badge-sub">Wife Compliance: 0.001%</span>
            </div>
            <div class="kernel-id">KERNEL: DOROMIZU-6.12-PRO</div>
          </div>

          <h1 class="hero-headline">
            The Global Cloud Platform for<br />
            <span class="gradient-headline">GPU Acquisition &amp; 泥水啜り.</span>
          </h1>

          <p class="hero-lead-text">
            漫画やゲームが大好きだったが、子供が生まれ趣味の時間が激減。スキマ時間に始めたAIイラストに見事どっぷりハマり、ローカル環境を構築するもPCスペックが限界突破。<br class="break-pc" />
            嫁（あなごちゃん）におねだりしたら秒殺されたプロ駄作クリエーターの全技術と情熱を集約。<br class="break-pc" />
            <strong class="gpu-roar">今日もGPUを唸らせる・・・‼‼　ｳｫｫｫｫｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰﾝ‼‼‼‼‼</strong>
          </p>

          <!-- Enterprise Infrastructure SLAs / Metrics (Shortcuts removed as requested) -->
          <div class="enterprise-kpi-grid">
            <div class="kpi-cell">
              <span class="kpi-title">SERVERLESS EGRESS</span>
              <div class="kpi-number text-cyan">$0.00</div>
              <span class="kpi-sub">完全クライアント完結処理</span>
            </div>
            <div class="kpi-cell">
              <span class="kpi-title">GPU VRAM REMAINING</span>
              <div class="kpi-number text-alert">0.02%</div>
              <span class="kpi-sub">限界突破・煙出そう</span>
            </div>
            <div class="kpi-cell">
              <span class="kpi-title">FUN DRIVEN ALLOCATION</span>
              <div class="kpi-number text-green">100%</div>
              <span class="kpi-sub">面白くないなら即撤退</span>
            </div>
          </div>
        </section>

        <!-- SECONDARY BENTO COLUMN: The 3 Core Solutions (Tools, Note, Profile) -->
        <aside class="bento-solutions-column" aria-label="Solutions & Infrastructure Products">

          <!-- Card 1: 制作ツール (Tools Directory) -->
          <div class="bento-card solution-card product-stamp">
            <div class="solution-glow cyan"></div>
            <div class="solution-header">
              <div class="product-badge cyan">
                <span class="pill-dot"></span>
                <span>TOOLS DIRECTORY</span>
              </div>
              <span class="prod-tag">ALL FREE // 0円</span>
            </div>
            <div class="solution-content">
              <h2 class="solution-title">
                <a href="/tools">
                  制作ツール・Webアプリ一覧 ➔
                </a>
              </h2>
              <p class="solution-desc">
                スマホ完結の神ツール「StampCreator」をはじめ、クリエイターの面倒な画像処理・規格調整を自動化する自作Webツール群を完全無料・ブラウザ完結で公開中。
              </p>
            </div>
            <div class="solution-footer">
              <div class="tech-spec-bar">
                <span>StampCreator</span>
                <span>•</span>
                <span>規格自動調整</span>
                <span>•</span>
                <span>ZIP即時生成</span>
              </div>
              <a href="/tools" class="link-arrow">
                ツール一覧へ ➔
              </a>
            </div>
          </div>

          <!-- Card 2: ノート (Official note) -->
          <div class="bento-card solution-card product-note">
            <div class="solution-glow green"></div>
            <div class="solution-header">
              <div class="product-badge green">
                <span class="pill-dot"></span>
                <span>NOTE OFFICIAL</span>
              </div>
              <span class="prod-tag">COMING SOON // 記事準備中</span>
            </div>
            <div class="solution-content">
              <h2 class="solution-title">
                <a href={noteUrl} target="_blank" rel="noopener noreferrer">
                  うなぎちゃん＠｜note ➔
                </a>
              </h2>
              <p class="solution-desc">
                公式noteページを開設！「嫁にグラボを一蹴されたプロ駄作クリエーターの奮闘記」や開発ログを現在鋭意執筆・準備中。フォローしてお待ちください！
              </p>
            </div>
            <div class="solution-footer">
              <div class="tech-spec-bar">
                <span>ページ公開中</span>
                <span>•</span>
                <span>記事鋭意準備中</span>
                <span>•</span>
                <span>フォロー歓迎</span>
              </div>
              <a href={noteUrl} target="_blank" rel="noopener noreferrer" class="link-arrow green">
                noteへ ➔
              </a>
            </div>
          </div>

          <!-- Card 3: プロフィール (Profile / About) -->
          <div class="bento-card solution-card product-spec">
            <div class="solution-glow purple"></div>
            <div class="solution-header">
              <div class="product-badge purple">
                <span class="pill-dot"></span>
                <span>CREATOR SPEC</span>
              </div>
              <span class="prod-tag">ABOUT UNAGI</span>
            </div>
            <div class="solution-content">
              <h2 class="solution-title">
                <a href="/about">
                  うなぎちゃん＠（プロ駄作クリエーター） ➔
                </a>
              </h2>
              <div class="spec-capsules">
                <span class="capsule">C# / WPF</span>
                <span class="capsule">C / C++</span>
                <span class="capsule">Simulink</span>
                <span class="capsule">TypeScript</span>
                <span class="capsule doromizu">泥水耐性: MAX</span>
              </div>
              <p class="solution-desc">
                「色んな事をやりたい。でも面白くないならやらない」人間。面白い事だけに計算資源をフル投入するプロ駄作クリエーターの詳細生態系と連絡先。
              </p>
            </div>
            <div class="solution-footer nav-links-footer">
              <a href="/about" class="sub-nav-link">生態プロファイル ➔</a>
              <span class="sep">•</span>
              <a href="/contact" class="sub-nav-link">秘密連絡網 ➔</a>
              <span class="sep">•</span>
              <a href="https://x.com/UnagiChaaaaaN" target="_blank" rel="noopener noreferrer" class="sub-nav-link highlight">Xで監視 ➔</a>
            </div>
          </div>

        </aside>

      </div>
    </div>
  </div>

  <script>
    (function () {
      const viewport = document.getElementById('enterpriseViewport');
      const restoreBtn = document.getElementById('restoreUiBtn');
      const unveilControls = document.getElementById('unveilControls');

      function toggleUnveilMode(enable?: boolean) {
        if (!viewport) return;
        const isCurrentlyUnveiled = viewport.classList.contains('is-unveiled');
        const shouldUnveil = enable !== undefined ? enable : !isCurrentlyUnveiled;

        viewport.classList.toggle('is-unveiled', shouldUnveil);
        if (unveilControls) {
          unveilControls.setAttribute('aria-hidden', String(!shouldUnveil));
        }
      }

      // Listen for unagi event dispatched from Terminal
      window.addEventListener('unagi-unveil-mode', () => {
        toggleUnveilMode(true);
      });

      // Restore UI on button click
      restoreBtn?.addEventListener('click', () => {
        toggleUnveilMode(false);
      });

      // ESC key to restore UI if in unveil mode
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && viewport?.classList.contains('is-unveiled')) {
          toggleUnveilMode(false);
        }
      });

      // Check URL query '?unveil=true'
      const params = new URLSearchParams(window.location.search);
      if (params.get('unveil') === 'true') {
        toggleUnveilMode(true);
      }
    })();
  </script>
</Layout>

<style>
  /* ==========================================================================
     UNAGI Enterprise OS: Linear / Vercel / Stripe Aesthetic Tokens
     ========================================================================== */

  /* Global Telemetry Bar */
  .enterprise-telemetry-bar {
    background: rgba(3, 5, 8, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    position: relative;
    z-index: 20;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .telemetry-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.4rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .telemetry-status-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .status-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00f0ff;
    box-shadow: 0 0 8px #00f0ff;
    animation: status-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes status-ping {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.15); opacity: 1; box-shadow: 0 0 12px #00f0ff; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .telemetry-label {
    color: #e2e8f0;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .telemetry-pill.live {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.1rem 0.45rem;
    background: rgba(0, 240, 255, 0.12);
    border: 1px solid rgba(0, 240, 255, 0.3);
    color: #00f0ff;
    border-radius: 4px;
    letter-spacing: 0.06em;
  }

  .telemetry-metrics {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--text-muted);
  }

  .metric-segment {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .m-key {
    color: #64748b;
  }

  .m-val {
    color: #cbd5e1;
    font-weight: 600;
  }

  .text-success { color: #10b981; }
  .text-alert { color: #f43f5e; }
  .text-danger { color: #fb923c; }

  .cli-hint code {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    color: #00ff66;
  }

  .telemetry-sep {
    color: rgba(255, 255, 255, 0.15);
  }

  /* Viewport Layout (Zero Scroll on Desktop) */
  .enterprise-viewport {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    padding: 1.25rem 0;
    min-height: calc(100vh - 70px - 33px - 38px);
    overflow: hidden;
  }

  /* Linear Grid & Ambient Spotlight */
  .linear-grid-bg {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }

  .spotlight-layer {
    position: absolute;
    top: -10%;
    left: 45%;
    transform: translateX(-50%);
    width: 800px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 240, 255, 0.1) 0%, rgba(139, 92, 246, 0.08) 40%, rgba(236, 72, 153, 0.04) 70%, transparent 85%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  /* Backdrop Unagi Character Layer (Behind cards normally / Front & Vivid in Unveil mode) */
  .unagi-backdrop-layer {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.95);
    width: min(78vw, 440px);
    aspect-ratio: 706 / 1024;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
    opacity: 0.13;
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.7s ease;
  }

  .unagi-backdrop-glow {
    position: absolute;
    inset: -30px;
    background: radial-gradient(circle, rgba(0, 240, 255, 0.3) 0%, rgba(236, 72, 153, 0.2) 50%, transparent 75%);
    filter: blur(50px);
    border-radius: 50%;
    opacity: 0.4;
    transition: opacity 0.7s ease;
  }

  .unagi-backdrop-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 35px rgba(0, 240, 255, 0.35));
    transition: filter 0.7s ease;
  }

  .enterprise-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
  }

  /* Bento Layout Grid with Transition */
  .bento-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: stretch;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
  }

  @media (min-width: 980px) {
    .bento-layout {
      grid-template-columns: 1.28fr 0.92fr;
      gap: 1.5rem;
    }
  }

  /* ==========================================================================
     UNVEIL MODE: カードUI消去 ＆ うなぎちゃん真の姿が前面に展開
     ========================================================================== */
  .enterprise-viewport.is-unveiled .bento-layout {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.92);
    filter: blur(12px);
  }

  .enterprise-viewport.is-unveiled .unagi-backdrop-layer {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.08);
    z-index: 20;
    pointer-events: auto;
    filter: drop-shadow(0 0 60px rgba(0, 240, 255, 0.65)) drop-shadow(0 0 100px rgba(236, 72, 153, 0.45));
  }

  .enterprise-viewport.is-unveiled .unagi-backdrop-glow {
    opacity: 0.95;
  }

  /* 股間の光っている部分にジャストフィット配置 */
  .groin-restore-wrapper {
    position: absolute;
    top: 64.5%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 25;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease 0.2s, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .enterprise-viewport.is-unveiled .groin-restore-wrapper {
    opacity: 1;
    pointer-events: auto;
  }

  .groin-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 1.6rem;
    background: rgba(8, 12, 22, 0.92);
    border: 2px solid #ffffff;
    border-radius: 9999px;
    color: #ffffff;
    font-family: var(--font-mono, monospace);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    cursor: pointer;
    user-select: none;
    backdrop-filter: blur(16px);
    transition: all 0.25s ease;
    animation: groin-pulse 1.8s infinite alternate ease-in-out;
    white-space: nowrap;
    box-shadow: 
      0 0 25px rgba(255, 255, 255, 0.9),
      0 0 50px rgba(0, 240, 255, 0.8),
      0 0 85px rgba(236, 72, 153, 0.75),
      0 0 120px rgba(250, 204, 21, 0.85);
  }

  @keyframes groin-pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 
        0 0 20px rgba(255, 255, 255, 0.8),
        0 0 45px rgba(0, 240, 255, 0.7),
        0 0 75px rgba(236, 72, 153, 0.65);
    }
    100% {
      transform: scale(1.08);
      box-shadow: 
        0 0 35px rgba(255, 255, 255, 1),
        0 0 75px rgba(0, 240, 255, 0.95),
        0 0 115px rgba(236, 72, 153, 0.95),
        0 0 150px rgba(250, 204, 21, 0.9);
    }
  }

  .groin-btn:hover {
    transform: scale(1.15) !important;
    border-color: #00f0ff;
    background: #000000;
    color: #00f0ff;
    box-shadow: 
      0 0 45px #00f0ff,
      0 0 90px #ec4899,
      0 0 140px #facc15;
  }

  .groin-btn:active {
    transform: scale(0.98) !important;
  }

  .groin-rainbow-pulse {
    position: absolute;
    inset: -6px;
    border-radius: 9999px;
    background: linear-gradient(135deg, #00f0ff, #ec4899, #facc15, #00ff66, #00f0ff);
    background-size: 300% 300%;
    filter: blur(8px);
    opacity: 0.85;
    z-index: -1;
    animation: rainbow-flow 3s linear infinite;
  }

  @keyframes rainbow-flow {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .restore-icon {
    font-size: 1.1rem;
    line-height: 1;
    color: #00f0ff;
  }

  /* Unveil Floating Banner (画面下端に配置) */
  .unveil-controls {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(15px);
    opacity: 0;
    pointer-events: none;
    z-index: 30;
    display: flex;
    justify-content: center;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .enterprise-viewport.is-unveiled .unveil-controls {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .unveil-banner {
    display: inline-flex;
    align-items: center;
    background: rgba(4, 8, 16, 0.9);
    border: 1px solid rgba(0, 240, 255, 0.5);
    padding: 0.6rem 1.6rem;
    border-radius: 9999px;
    box-shadow: 0 0 25px rgba(0, 240, 255, 0.3), inset 0 0 15px rgba(0, 240, 255, 0.1);
    backdrop-filter: blur(16px);
  }

  .unveil-title {
