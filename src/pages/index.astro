---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import PostCard from '../components/PostCard.astro';
import { toolsData } from '../data/tools';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const featuredTool = toolsData[0];
const noteUrl = "https://note.com/unagichaaaan";
---

<Layout
  title="うなぎちゃん公式サイト | 嫁にグラボを一蹴されたエンジニアおじさんの逆襲ポータル"
  description="AIイラストでPC限界→嫁（あなごちゃん）にグラボ購入を一蹴されたエンジニアのおじさん「うなぎちゃん（@UnagiChaaaaaN）」が、趣味をそのまま収益化するチャレンジの公式ポータル。仕事じゃないのでやりたい事しかやりません！"
>
  <!-- Hero Section: Hyper Momentum & Husband's Revenge -->
  <section class="hero-section">
    <div class="hero-glow"></div>
    <div class="container hero-container">
      <div class="hero-badge-wrap">
        <span class="cyber-badge pink">MISSION: GET NEW GPU // 嫁（あなごちゃん）攻略作戦</span>
        <span class="hero-subtext">UNAGI VS ANAGO</span>
      </div>

      <h1 class="hero-title">
        グラボが欲しい。<br />
        <span class="gradient-text">嫁に一蹴されたエンジニアおじさんの逆襲。</span>
      </h1>

      <p class="hero-description">
        AIイラストで遊び狂っていたらPCのスペックが限界を迎えた。<br />
        新しいグラボをおねだりしたら嫁（あなごちゃん）に「高すぎ」と秒で一蹴されたエンジニアのおじさん（うなぎちゃん）の公式ポータルだッ！！<br />
        『じゃあ自分のスキルを活かして、趣味をそのまま収益化してグラボ代稼げば文句ないだろ！？』と色々やってみるチャレンジ中！<br class="hidden-mobile" />
        ※ただし仕事じゃないので、本当にやりたいことしかやりません！！（でもグラボのためなら靴も舐めるかもしれません）
      </p>

      <div class="hero-cta-group">
        <a href="https://stampcreator.unagichan.com/" target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-primary pulse-btn">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span>StampCreator を使う（グラボへの一歩）</span>
        </a>
        <a href={noteUrl} target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-note">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <span>noteで奮闘記を読む（脳汁ログ）</span>
        </a>
        <a href="https://x.com/UnagiChaaaaaN" target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-secondary x-btn">
          <svg class="x-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          <span>Xで生存確認（叫べ）</span>
        </a>
      </div>

      <!-- Passionate Metrics -->
      <div class="metrics-grid">
        <div class="metric-item">
          <span class="metric-value">Goal: グラボ～その先へ～</span>
          <span class="metric-label">嫁の鉄壁ガード突破は通過点、未知の領域へ</span>
        </div>
        <div class="metric-item">
          <span class="metric-value">100% 自由</span>
          <span class="metric-label">仕事じゃないのでやりたい事しかやらない主義</span>
        </div>
        <div class="metric-item">
          <span class="metric-value">0円</span>
          <span class="metric-label">ツールは完全無料！愛と勢いだけで動いている！</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Tool Section -->
  <section class="section section-tools">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="cyber-badge cyan">PRIMARY WEAPON</span>
        </div>
        <h2 class="section-title">注目の制作ツール「StampCreator」（現在これに命をかけてる）</h2>
        <p class="section-desc">
          AIイラストでスタンプ作ってたら、LINEの偶数ドット制限や余白調整が面倒すぎて『やってられるかァァッ！』とブチギレて自作した神ツール。<br />
          画像を入れた瞬間、宇宙の理（ことわり）に従って完璧なZIPが爆誕する。使ってくれッ！！
        </p>
      </div>

      <div class="featured-tool-wrapper">
        <ToolCard tool={featuredTool} featured={true} />
      </div>

      <div class="section-more">
        <a href="/tools" class="more-link">
          <span>すべての制作ツール・プロジェクトを見る</span>
          <svg class="arrow-right" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- note & Blog Section: Brain Meltdown Archives -->
  <section class="section section-blog">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="cyber-badge purple">NOTE &amp; DEV LOGS</span>
        </div>
        <h2 class="section-title">脳汁が出た瞬間の記録（note連動・開発ブログ）</h2>
        <p class="section-desc">
          「グラボ欲しい」「AIイラストPC限界」「嫁の鉄壁ガード」「個人ツールの収益化挑戦」など、<br class="hidden-mobile" />
          リアルなエンジニアおじさんの試行錯誤と脳汁メモをnoteやブログで大公開中！読めッ！！
        </p>
      </div>

      <!-- note Banner Card -->
      <div class="note-banner-wrapper">
        <a href={noteUrl} target="_blank" rel="noopener noreferrer" class="cyber-card note-feature-card">
          <div class="note-card-inner">
            <div class="note-badge-row">
              <span class="cyber-badge green">NOTE OFFICIAL</span>
              <span class="note-subtext">リアルタイム奮闘記</span>
            </div>
            <h3 class="note-card-title">
              noteにて「嫁にグラボを一蹴されたエンジニアおじさんの収益化奮闘記」連載中！
            </h3>
            <p class="note-card-desc">
              技術メモから日常の叫び、個人開発マネタイズの裏側まで、本音100%で書き殴っています。フォロー＆スキでグラボ代への応援待ってます！
            </p>
            <div class="note-card-footer">
              <span class="note-link-text">note（ノート）で記事を読む ➔</span>
            </div>
          </div>
        </a>
      </div>

      <div class="blog-grid">
        {sortedPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>

      <div class="section-more">
        <a href={noteUrl} target="_blank" rel="noopener noreferrer" class="more-link">
          <span>noteで開発奮闘記をすべて読む</span>
          <svg class="arrow-right" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Intense Passion & Contact Section -->
  <section class="section section-feedback">
    <div class="container">
      <div class="cyber-card feedback-card">
        <div class="feedback-inner">
          <span class="cyber-badge pink">WIFE PRESENTATION</span>
          <h2 class="feedback-title">叫べ！応援しろ！嫁に『ほら見ろ』と言わせろッ！！</h2>
          <p class="feedback-desc">
            うなぎちゃんは褒められると光速を超えます。<br />
            「おじさん頑張れ」「このツール便利だからグラボ買ってやれ」「嫁（あなごちゃん）を説得しろ」など、<br class="hidden-mobile" />
            温かい応援リプライをX（旧Twitter）に叩き込んでくれ！！嫁へのプレゼン資料にします！！
          </p>
          <div class="feedback-actions">
            <a
              href="https://x.com/intent/tweet?text=%40UnagiChaaaaaN%20%E3%81%8A%E3%81%98%E3%81%95%E3%82%93%E6%96%B0%E3%81%97%E3%81%84%E3%82%B0%E3%83%A9%E3%83%9C%E8%B2%B7%E3%81%A3%E3%81%A6%E3%82%82%E3%82%89%E3%81%88%EF%BC%81%20%E5%AB%81%E3%81%95%E3%82%93%E8%A8%B1%E3%81%97%E3%81%A6%E3%81%82%E3%81%92%E3%81%A6%EF%BC%81%20https%3A%2F%2Funagichan.com"
              target="_blank"
              rel="noopener noreferrer"
              class="cyber-btn cyber-btn-primary"
            >
              <svg class="x-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              <span>X（Twitter）で嫁説得の援護射撃をする</span>
            </a>
            <a href="/contact" class="cyber-btn cyber-btn-secondary">
              <span>メールでこっそり応援する</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About / Vision Teaser -->
  <section class="section section-about-teaser">
    <div class="container">
      <div class="cyber-card about-card">
        <div class="about-grid">
          <div class="about-content">
            <span class="cyber-badge">ABOUT UNAGI (SPEC)</span>
            <h2 class="about-title">うなぎちゃん（エンジニアおじさん）の生態</h2>
            <p class="about-text">
              AIイラストの生成制限とPCスペックの限界に直面し、最新グラボ（激高）をおねだりするも嫁（あなごちゃん）に一蹴された哀愁とパッションのエンジニアおじさん。<br />
              「仕事じゃないのでやりたい事しかやらない」を絶対の掟とし、己のフロントエンド技術で自作ツール開発＆収益化に挑んでいます。
            </p>
            <div class="about-links">
              <a href="/about" class="cyber-btn cyber-btn-primary">
                詳しいプロフィール・経緯を読む
              </a>
              <a href="https://x.com/UnagiChaaaaaN" target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-secondary">
                X（旧Twitter）で監視する
              </a>
            </div>
          </div>
          <div class="about-deco">
            <div class="code-terminal">
              <div class="terminal-bar">
                <span class="t-dot red"></span>
                <span class="t-dot yellow"></span>
                <span class="t-dot green"></span>
                <span class="terminal-title">unagi_profile.ts</span>
              </div>
              <pre><code>const creator = &#123;
  name: "うなぎちゃん（エンジニアおじさん）",
  rival: "あなごちゃん（最強の嫁）",
  ultimate_goal: "グラボ獲得、そしてその先へ――",
  philosophy: "やりたい事しかやらない（でもグラボのためなら靴も舐める）",
  current_pc: "AI生成で限界・煙が出そう",
  weapon: ["Canvas API", "TypeScript", "note", "勢い"],
  status: "嫁の稟議突破に向けて爆走中！！"
&#125;;</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 5rem;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 420px;
    background: radial-gradient(circle, rgba(236, 72, 153, 0.15) 0%, rgba(0, 240, 255, 0.12) 40%, rgba(139, 92, 246, 0.08) 60%, transparent 80%);
    filter: blur(70px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .hero-subtext {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--cyan);
    letter-spacing: 0.12em;
    font-weight: 700;
  }

  .hero-title {
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.4rem;
    }
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 760px;
    line-height: 1.85;
    margin-bottom: 2.5rem;
  }

  .hidden-mobile {
    display: none;
  }

  @media (min-width: 768px) {
    .hidden-mobile {
      display: inline;
    }
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .pulse-btn {
    box-shadow: 0 0 25px rgba(0, 240, 255, 0.4);
    animation: btn-glow 2s infinite alternate ease-in-out;
  }

  @keyframes btn-glow {
    0% { box-shadow: 0 0 15px rgba(0, 240, 255, 0.3); }
    100% { box-shadow: 0 0 35px rgba(236, 72, 153, 0.5), 0 0 15px rgba(0, 240, 255, 0.5); }
  }

  .cyber-btn-note {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.2), rgba(16, 185, 129, 0.3));
    border-color: #10b981;
    color: #ffffff;
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.25);
  }

  .cyber-btn-note:hover {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.35), rgba(16, 185, 129, 0.45));
    box-shadow: 0 0 25px rgba(16, 185, 129, 0.45);
    transform: translateY(-2px);
    color: #fff;
  }

  .btn-icon {
    width: 18px;
    height: 18px;
  }

  .x-icon {
    width: 16px;
    height: 16px;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    width: 100%;
    max-width: 800px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 2.25rem;
  }

  @media (max-width: 600px) {
    .metrics-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--cyan);
    letter-spacing: -0.01em;
  }

  .metric-label {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Section Common */
  .section {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-badge {
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 640px;
    line-height: 1.7;
  }

  .section-more {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--cyan);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.55rem 1.35rem;
    border: 1px solid rgba(0, 240, 255, 0.25);
    border-radius: var(--radius-full);
    background: rgba(0, 240, 255, 0.05);
    transition: all 0.25s ease;
  }

  .more-link:hover {
    background: rgba(0, 240, 255, 0.15);
    border-color: var(--cyan);
    transform: translateY(-2px);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.25);
  }

  .arrow-right {
    width: 16px;
    height: 16px;
  }

  /* Featured Tool */
  .featured-tool-wrapper {
    max-width: 840px;
    margin: 0 auto;
  }

  /* note Banner Card */
  .note-banner-wrapper {
    max-width: 840px;
    margin: 0 auto 2.5rem;
  }

  .note-feature-card {
    display: block;
    padding: 2rem 2.5rem;
    border-left: 4px solid #10b981;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(14, 20, 36, 0.8) 100%);
    transition: all 0.3s ease;
  }

  .note-feature-card:hover {
    border-color: #34d399;
    box-shadow: 0 10px 30px rgba(16, 185, 129, 0.2);
    transform: translateY(-3px);
  }

  .note-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .note-subtext {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #34d399;
    letter-spacing: 0.05em;
  }

  .note-card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .note-card-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .note-link-text {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: #34d399;
  }

  /* Blog Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Feedback Card */
  .feedback-card {
    max-width: 840px;
    margin: 0 auto;
    padding: 3.5rem 2.5rem;
    text-align: center;
    border-top: 2px solid var(--pink);
    box-shadow: 0 0 30px rgba(236, 72, 153, 0.15);
  }

  .feedback-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .feedback-title {
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.3;
  }

  .feedback-desc {
    color: var(--text-secondary);
    font-size: 1.02rem;
    max-width: 640px;
    line-height: 1.8;
  }

  .feedback-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.75rem;
  }

  /* About Teaser */
  .about-card {
    padding: 3rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.35;
  }

  .about-text {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 0.98rem;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  /* Terminal Mockup */
  .code-terminal {
    background: #060911;
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-subtle);
  }

  .t-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .t-dot.red { background: #ef4444; }
  .t-dot.yellow { background: #f59e0b; }
  .t-dot.green { background: #10b981; }

