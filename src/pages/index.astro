  </div>

  <script>
    (function () {
      const viewport = document.getElementById('enterpriseViewport');
      const restoreBtn = document.getElementById('restoreUiBtn');
      const unveilControls = document.getElementById('unveilControls');
      const heroCliBtn = document.getElementById('heroCliBtn');

      function toggleUnveilMode(enable?: boolean) {
        if (!viewport) return;
        const isCurrentlyUnveiled = viewport.classList.contains('is-unveiled');
        const shouldUnveil = enable !== undefined ? enable : !isCurrentlyUnveiled;

        viewport.classList.toggle('is-unveiled', shouldUnveil);
        if (unveilControls) {
          unveilControls.setAttribute('aria-hidden', String(!shouldUnveil));
        }
      }

      // Hero CLI Button trigger
      heroCliBtn?.addEventListener('click', () => {
        if (typeof (window as any).toggleUnagiTerminal === 'function') {
          (window as any).toggleUnagiTerminal();
        } else {
          window.dispatchEvent(new CustomEvent('open-unagi-terminal'));
        }
      });

      // Listen for unagi event dispatched from Terminal
      window.addEventListener('unagi-unveil-mode', () => {
        toggleUnveilMode(true);
      });

      // Restore UI on button click
      restoreBtn?.addEventListener('click', () => {
        toggleUnveilMode(false);
      });

      // ESC key to restore UI if in unveil mode
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && viewport?.classList.contains('is-unveiled')) {
          toggleUnveilMode(false);
        }
      });

      // Check URL query '?unveil=true'
      const params = new URLSearchParams(window.location.search);
      if (params.get('unveil') === 'true') {
        toggleUnveilMode(true);
      }
    })();
  </script>
