---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import PostCard from '../components/PostCard.astro';
import { toolsData } from '../data/tools';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const featuredTool = toolsData[0];
---

<Layout
  title="うなぎちゃん公式サイト | 面倒な作業を自動化するクリエイター支援ポータル"
  description="個人開発者「うなぎちゃん（@UnagiChaaaaaN）」の公式ポータル。スマホ完結LINEスタンプ制作ツール「StampCreator」をはじめ、面倒な作業を全部押し付けられる便利なWebツールと開発ノウハウを公開中。"
>
  <!-- Hero Section: Simple Modern & Playful -->
  <section class="hero-section">
    <div class="hero-glow"></div>
    <div class="container hero-container">
      <div class="hero-badge-wrap">
        <span class="cyber-badge">UNAGI LAB // PROBABLY STABLE</span>
        <span class="hero-subtext">DEVELOPER &amp; CREATOR</span>
      </div>

      <h1 class="hero-title">
        面倒な作業、<br />
        <span class="gradient-text">全部Webツールに押し付けよう。</span>
      </h1>

      <p class="hero-description">
        個人開発者「うなぎちゃん」の公式ポータルサイトです。<br />
        絵を描くのは楽しいけれど、画像のドット数調整やZIPまとめ作業とかマジでだるいので、
        全部ブラウザ内で自動処理するツールを作りました。登録不要・完全無料。使って。
      </p>

      <!-- Mini Playful AA Box -->
      <div class="mini-aa-card" aria-hidden="true">
        <pre class="mini-aa"><code> ∧＿∧
(・∀・)　＜ 便利だから使ってね。
( つ旦つ　　 お茶でも飲みながらどうぞ。</code></pre>
      </div>

      <div class="hero-cta-group">
        <a href="https://stampcreator.unagichan.com/" target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-primary">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span>StampCreator を使う（自称神ツール）</span>
        </a>
        <a href="/tools" class="cyber-btn cyber-btn-secondary">
          <span>制作ツール一覧を見る</span>
        </a>
        <a href="https://x.com/UnagiChaaaaaN" target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-secondary x-btn">
          <svg class="x-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          <span>X @UnagiChaaaaaN（生存確認）</span>
        </a>
      </div>

      <!-- Playful Metrics -->
      <div class="metrics-grid">
        <div class="metric-item">
          <span class="metric-value">0秒</span>
          <span class="metric-label">面倒な会員登録（存在しません）</span>
        </div>
        <div class="metric-item">
          <span class="metric-value">100%</span>
          <span class="metric-label">Client-Side（画像は見ないし保存もしない）</span>
        </div>
        <div class="metric-item">
          <span class="metric-value">0円</span>
          <span class="metric-label">完全無料（うなぎちゃんの善意で運用中）</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Tool Section -->
  <section class="section section-tools">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="cyber-badge pink">FLAGSHIP PRODUCT</span>
        </div>
        <h2 class="section-title">注目の制作ツール（というか現在これに命をかけてる）</h2>
        <p class="section-desc">
          LINE Creators Marketの細かいピクセル制限にブチギレた結果生まれた、奇跡の一括自動化ツールです。
        </p>
      </div>

      <div class="featured-tool-wrapper">
        <ToolCard tool={featuredTool} featured={true} />
      </div>

      <div class="section-more">
        <a href="/tools" class="more-link">
          <span>すべての制作ツール・プロジェクトを見る</span>
          <svg class="arrow-right" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="section section-blog">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="cyber-badge purple">DEV &amp; LIFE NOTES</span>
        </div>
        <h2 class="section-title">技術メモと制作ノウハウ</h2>
        <p class="section-desc">
          夜中に突然ひらめいた実装ティップスや、個人開発のリアルな知見を気ままに書き散らしています。
        </p>
      </div>

      <div class="blog-grid">
        {sortedPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>

      <div class="section-more">
        <a href="/blog" class="more-link">
          <span>記事一覧をすべて読む</span>
          <svg class="arrow-right" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Cheerful Message & Feedback Section -->
  <section class="section section-feedback">
    <div class="container">
      <div class="cyber-card feedback-card">
        <div class="feedback-inner">
          <span class="cyber-badge">TALK TO CREATOR</span>
          <h2 class="feedback-title">褒められると伸びるタイプです。</h2>
          <p class="feedback-desc">
            ツールの感想、「ここ直してほしい」というバグ報告、「こんな機能あったら神」というアイデアなど、
            お気軽にX（旧Twitter）でリプライ飛ばしてください。開発モチベが急上昇します。
          </p>
          <div class="feedback-actions">
            <a
              href="https://x.com/intent/tweet?text=%40UnagiChaaaaaN%20%E3%81%86%E3%81%AA%E3%81%8E%E3%81%A1%E3%82%83%E3%82%93%E3%81%AE%E3%83%84%E3%83%BC%E3%83%AB%E4%BD%BF%E3%81%A3%E3%81%9F%E3%82%88%EF%BC%81%20https%3A%2F%2Funagichan.com"
              target="_blank"
              rel="noopener noreferrer"
              class="cyber-btn cyber-btn-primary"
            >
              <svg class="x-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              <span>Xでうなぎちゃんにリプライを送る</span>
            </a>
            <a href="/contact" class="cyber-btn cyber-btn-secondary">
              <span>メールでこっそり送る</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About / Vision Teaser -->
  <section class="section section-about-teaser">
    <div class="container">
      <div class="cyber-card about-card">
        <div class="about-grid">
          <div class="about-content">
            <span class="cyber-badge pink">ABOUT CREATOR</span>
            <h2 class="about-title">「シンプルで役に立つ」を、すぐそばに。</h2>
            <p class="about-text">
              はじめまして！個人開発者のうなぎちゃん（@UnagiChaaaaaN）です。<br />
              「自分が本当に使いたいツール」「同じ悩みを持つクリエイターが笑顔になるツール」をモットーに、
              日夜Webフロントエンド開発やデザインを行っています。
            </p>
            <div class="about-links">
              <a href="/about" class="cyber-btn cyber-btn-primary">
                詳しいプロフィールを読む
              </a>
              <a href="https://x.com/UnagiChaaaaaN" target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-secondary">
                X（旧Twitter）をフォロー
              </a>
            </div>
          </div>
          <div class="about-deco">
            <div class="code-terminal">
              <div class="terminal-bar">
                <span class="t-dot red"></span>
                <span class="t-dot yellow"></span>
                <span class="t-dot green"></span>
                <span class="terminal-title">unagichan_profile.ts</span>
              </div>
              <pre><code>const creator = &#123;
  name: "うなぎちゃん",
  handle: "@UnagiChaaaaaN",
  mission: "面倒な作業は全部機械にやらせる",
  coffee: "必需品",
  bugs: "見つけたら優しく教えてください",
  status: "Shipping great tools &amp; writing tips!"
&#125;;</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 5rem;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 650px;
    height: 380px;
    background: radial-gradient(circle, rgba(0, 240, 255, 0.12) 0%, rgba(139, 92, 246, 0.08) 50%, transparent 80%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .hero-subtext {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .hero-title {
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.4rem;
    }
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 680px;
    line-height: 1.8;
    margin-bottom: 1.75rem;
  }

  /* Mini AA Card */
  .mini-aa-card {
    background: rgba(6, 10, 20, 0.6);
    border: 1px dashed rgba(0, 240, 255, 0.25);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1.25rem;
    margin-bottom: 2rem;
    display: inline-block;
  }

  .mini-aa {
    font-family: "MS PGothic", "IPAMonaPGothic", "Mona", "Noto Sans JP", sans-serif;
    font-size: 13.5px;
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--cyan);
    margin: 0;
    text-align: left;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .btn-icon {
    width: 18px;
    height: 18px;
  }

  .x-icon {
    width: 16px;
    height: 16px;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: 760px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 2rem;
  }

  @media (max-width: 600px) {
    .metrics-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--cyan);
  }

  .metric-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Section Common */
  .section {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-badge {
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 600px;
    line-height: 1.7;
  }

  .section-more {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--cyan);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: var(--radius-full);
    background: rgba(0, 240, 255, 0.05);
    transition: all 0.25s ease;
  }

  .more-link:hover {
    background: rgba(0, 240, 255, 0.15);
    border-color: var(--cyan);
    transform: translateY(-2px);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.25);
  }

  .arrow-right {
    width: 16px;
    height: 16px;
  }

  /* Featured Tool */
  .featured-tool-wrapper {
    max-width: 820px;
    margin: 0 auto;
  }

  /* Blog Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Feedback Card */
  .feedback-card {
    max-width: 820px;
    margin: 0 auto;
    padding: 3rem 2.5rem;
    text-align: center;
    border-top: 2px solid var(--cyan);
  }

  .feedback-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .feedback-title {
    font-size: 1.85rem;
    font-weight: 700;
    color: #fff;
  }

  .feedback-desc {
    color: var(--text-secondary);
    font-size: 0.98rem;
    max-width: 600px;
    line-height: 1.75;
  }

  .feedback-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  /* About Teaser */
  .about-card {
    padding: 3rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.35;
  }

  .about-text {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 0.98rem;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  /* Terminal Mockup */
  .code-terminal {
    background: #060911;
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-subtle);
  }

  .t-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .t-dot.red { background: #ef4444; }
  .t-dot.yellow { background: #f59e0b; }
  .t-dot.green { background: #10b981; }

  .terminal-title {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .code-terminal pre {
    padding: 1.25rem;
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: #38bdf8;
    background: transparent !important;
  }
</style>
