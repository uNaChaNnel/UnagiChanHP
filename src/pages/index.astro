---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import PostCard from '../components/PostCard.astro';
import { toolsData } from '../data/tools';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const featuredTool = toolsData[0];
---

<Layout
  title="うなぎちゃんねる (uNaChaNnel) | クリエイター支援ツール＆公式ブログ"
  description="うなぎちゃん（@UnagiChaaaaaN）の公式ポータル。スマホ完結LINEスタンプ制作ツール「StampCreator」をはじめとする自作Webツール開発と、開発ノウハウを発信中。"
>
  <!-- Hero Section: 2ch Neo-Retro Main Thread -->
  <section class="hero-section">
    <div class="hero-glow"></div>
    <div class="container hero-container">
      <div class="thread-wrapper">
        <!-- Thread Main Box -->
        <div class="cyber-card thread-main-card">
          <!-- 2ch Header Bar -->
          <div class="thread-meta-bar">
            <span class="bbs-board-badge">【総合開発板】</span>
            <span class="bbs-thread-status">勢い: 1250 res/h ｜ Dat落ちなし ｜ 転載禁止©uNaChaNnel</span>
          </div>

          <div class="thread-content-inner">
            <!-- >>1 Res Header -->
            <div class="res-header main-res-header">
              <span class="res-num">1</span>
              <span class="res-colon">：</span>
              <span class="res-name">うなぎちゃん ★ ＠転載は禁止</span>
              <span class="res-trip">◆Unagi/Dev</span>
              <span class="res-date">2026/09/25(金) 11:15:00.00</span>
              <span class="res-id">ID:UNAGI/Admin</span>
            </div>

            <h1 class="hero-title">
              【速報】クリエイターの「つくりたい」を<br />
              <span class="gradient-text">テクノロジーで加速するスレ【uNaChaNnel】</span>
            </h1>

            <!-- Cyber AA Box (うなぎちゃん × モナー AA) -->
            <div class="cyber-aa-box" aria-label="うなぎちゃんのアスキーアート">
              <pre class="cyber-aa"><code>　　 ∧＿∧　　 ／￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣
　　(・∀・ ) ＜　うなぎちゃんねる（uNaChaNnel）へようこそ！
　　( つ　 つ　 ＼　スマホ完結LINEスタンプ制作ツール StampCreator 公開中だお！
　　 |　｜ ｜　　 ＼＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿
　　(_＿)＿)</code></pre>
            </div>

            <div class="hero-description">
              <p>
                <span class="res-anchor">&gt;&gt;1</span> 乙！<br />
                個人開発者「うなぎちゃん」の公式ポータルサイトです。<br />
                スマホ完結の制作支援Webツール <strong>StampCreator</strong> の公開や、
                Webフロントエンド開発・UI/UX・創作ノウハウをまとめた実践的ブログをお届けします。sage進行推奨。
              </p>
            </div>

            <!-- Action Buttons -->
            <div class="hero-cta-group">
              <a href="https://stampcreator.unagichan.com/" target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-primary">
                <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span>StampCreator を使う (&gt;&gt;1 推奨)</span>
              </a>
              <a href="/tools" class="cyber-btn cyber-btn-secondary">
                <span>制作ツール一覧 (【ツール板】)</span>
              </a>
              <a href="https://x.com/UnagiChaaaaaN" target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-secondary x-btn">
                <svg class="x-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                <span>X @UnagiChaaaaaN</span>
              </a>
            </div>

            <!-- Quick Metrics -->
            <div class="metrics-grid">
              <div class="metric-item">
                <span class="metric-value">100%</span>
                <span class="metric-label">Client-Side Process (画像非保存・安心安全)</span>
              </div>
              <div class="metric-item">
                <span class="metric-value">0円</span>
                <span class="metric-label">登録不要・完全無料 (sage進行)</span>
              </div>
              <div class="metric-item">
                <span class="metric-value">Mobile</span>
                <span class="metric-label">スマホ・iPad完全対応 (専ブラ不要)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Tool Section -->
  <section class="section section-tools">
    <div class="container">
      <div class="section-header">
        <div class="res-header" style="margin-bottom: 0.5rem;">
          <span class="res-num">100</span>
          <span class="res-colon">：</span>
          <span class="res-name">うなぎちゃん ◆Unagi/Dev</span>
          <span class="res-date">2026/09/25(金) 12:00:00.00</span>
          <span class="res-id">ID:StampCreator</span>
        </div>
        <h2 class="section-title">【神ツール】StampCreator - スマホ完結LINEスタンプ制作支援ツール【本スレ】</h2>
        <p class="section-desc">
          <span class="res-anchor">&gt;&gt;1</span> 厳格なLINE Creators Market画像規格を一括自動変換する、クリエイター必携の自作Webツールです。
        </p>
      </div>

      <div class="featured-tool-wrapper">
        <ToolCard tool={featuredTool} featured={true} />
      </div>

      <div class="section-more">
        <a href="/tools" class="more-link">
          <span>【ツール板】すべての制作ツール・プロジェクトを見る</span>
          <svg class="arrow-right" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="section section-blog">
    <div class="container">
      <div class="section-header">
        <div class="res-header" style="margin-bottom: 0.5rem;">
          <span class="res-num">1</span>
          <span class="res-colon">：</span>
          <span class="res-name">名無しさん＠プログラマー</span>
          <span class="res-date">2026/09/25(金) 12:30:00.00</span>
          <span class="res-id">ID:WebDev2026</span>
        </div>
        <h2 class="section-title">【技術】うなぎちゃん開発ノート＆制作ノウハウ総合スレッド Part.1</h2>
        <p class="section-desc">
          LINEスタンプ規格の攻略法、Web開発技術、個人ツールのUI/UX設計などを実践的に解説。新着レス一覧です。
        </p>
      </div>

      <div class="blog-grid">
        {sortedPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>

      <div class="section-more">
        <a href="/blog" class="more-link">
          <span>【開発ノート板】スレッドの過去ログ・記事一覧をすべて読む</span>
          <svg class="arrow-right" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Neo-2ch Res Form (Interactive message/contact teaser) -->
  <section class="section section-post-box">
    <div class="container">
      <div class="cyber-card bbs-form-card">
        <div class="bbs-form-header">
          <div class="res-header">
            <span class="res-num">書き込み</span>
            <span class="res-colon">：</span>
            <span class="res-name">スレッドにメッセージを投稿する（応援・要望）</span>
          </div>
          <span class="bbs-sage-badge">sage推奨</span>
        </div>

        <div class="bbs-form-fields">
          <div class="bbs-input-row">
            <div class="bbs-field-group">
              <label class="bbs-field-label">名前：</label>
              <input type="text" class="bbs-input" value="名無しさん＠お腹いっぱい。" readonly />
            </div>
            <div class="bbs-field-group">
              <label class="bbs-field-label">E-mail：</label>
              <input type="text" class="bbs-input" value="sage" readonly />
            </div>
          </div>

          <div class="bbs-textarea-wrap">
            <textarea
              class="bbs-textarea"
              rows="3"
              placeholder="うなぎちゃんへの応援メッセージ、StampCreatorの機能要望、感想などをどうぞ！"
              id="bbsMessageInput"
            ></textarea>
          </div>

          <div class="bbs-form-actions">
            <a
              href="https://x.com/intent/tweet?text=%40UnagiChaaaaaN%20%E3%81%86%E3%81%AA%E3%81%8E%E3%81%A1%E3%82%83%E3%82%93%E3%81%AD%E3%82%8B%E8%A6%8B%E3%81%9F%E3%82%88%EF%BC%81%20https%3A%2F%2Funagichan.com"
              target="_blank"
              rel="noopener noreferrer"
              class="cyber-btn cyber-btn-primary"
              id="postToXBtn"
            >
              <svg class="x-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              <span>書き込む (Xでポスト・DM)</span>
            </a>
            <a href="/contact" class="cyber-btn cyber-btn-secondary">
              <span>【お問い合わせ板】メールで送る</span>
            </a>
          </div>

          <p class="bbs-form-note">
            ※ 荒らし・誹謗中傷は禁止です。創作活動を応援し合う温かいスレッド進行にご協力ください。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- About / Vision Teaser -->
  <section class="section section-about-teaser">
    <div class="container">
      <div class="cyber-card about-card thread-card">
        <div class="about-grid">
          <div class="about-content">
            <div class="res-header">
              <span class="res-num">1</span>
              <span class="res-colon">：</span>
              <span class="res-name">うなぎちゃん ★ ＠転載は禁止</span>
              <span class="res-date">2026/09/25(金)</span>
              <span class="res-id">ID:UnagiProfile</span>
            </div>
            <h2 class="about-title">【自己紹介】開発者「うなぎちゃん」について語るスレ</h2>
            <p class="about-text">
              はじめまして！個人開発者のうなぎちゃん（@UnagiChaaaaaN）です。<br />
              「自分が本当に使いたいツール」「同じ悩みを持つクリエイターが笑顔になるツール」をモットーに、
              日夜Webフロントエンド開発やUIデザインを行っています。
            </p>
            <div class="about-links">
              <a href="/about" class="cyber-btn cyber-btn-primary">
                【自己紹介板】詳しいプロフィールを読む
              </a>
              <a href="https://x.com/UnagiChaaaaaN" target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-secondary">
                X（旧Twitter）をフォロー
              </a>
            </div>
          </div>
          <div class="about-deco">
            <div class="code-terminal">
              <div class="terminal-bar">
                <span class="t-dot red"></span>
                <span class="t-dot yellow"></span>
                <span class="t-dot green"></span>
                <span class="terminal-title">unagichan_profile.ts</span>
              </div>
              <pre><code>const creator = &#123;
  name: "うなぎちゃん",
  handle: "@UnagiChaaaaaN",
  trip: "◆Unagi/Dev",
  stack: ["Astro", "TypeScript", "Cloudflare"],
  mission: "クリエイター支援と爆速Webツールの創造",
  status: "Shipping great tools &amp; writing tips!"
&#125;;</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // メッセージ入力欄とXポストボタンの連動
  const msgInput = document.getElementById('bbsMessageInput') as HTMLTextAreaElement | null;
  const postBtn = document.getElementById('postToXBtn') as HTMLAnchorElement | null;

  if (msgInput && postBtn) {
    msgInput.addEventListener('input', () => {
      const userText = msgInput.value.trim();
      const base = 'https://x.com/intent/tweet?text=';
      const textToShare = userText
        ? encodeURIComponent(`@UnagiChaaaaaN ${userText}\n#うなぎちゃんねる https://unagichan.com`)
        : encodeURIComponent('@UnagiChaaaaaN うなぎちゃんねる見たよ！ https://unagichan.com');
      postBtn.href = base + textToShare;
    });
  }
</script>

<style>
  /* Hero Section */
  .hero-section {
    position: relative;
    padding-top: 3.5rem;
    padding-bottom: 4.5rem;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 400px;
    background: radial-gradient(circle, rgba(0, 240, 255, 0.12) 0%, rgba(139, 92, 246, 0.08) 50%, transparent 80%);
    filter: blur(70px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    position: relative;
    z-index: 1;
  }

  .thread-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .thread-main-card {
    border-top: 2px solid var(--cyan);
    border-left: 1px solid rgba(0, 240, 255, 0.25);
    background: linear-gradient(180deg, rgba(16, 24, 44, 0.85) 0%, rgba(8, 12, 22, 0.95) 100%);
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.7), 0 0 25px rgba(0, 240, 255, 0.12);
  }

  .thread-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1.5rem;
    background: rgba(0, 240, 255, 0.05);
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .bbs-board-badge {
    color: var(--cyan);
    font-weight: 700;
  }

  .bbs-thread-status {
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .thread-meta-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }

  .thread-content-inner {
    padding: 2.25rem;
  }

  @media (max-width: 600px) {
    .thread-content-inner {
      padding: 1.5rem 1.25rem;
    }
  }

  .main-res-header {
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
  }

  .res-colon {
    color: var(--text-muted);
  }

  .hero-title {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 2.65rem;
    }
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .hero-description strong {
    color: #fff;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .btn-icon {
    width: 18px;
    height: 18px;
  }

  .x-icon {
    width: 16px;
    height: 16px;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.75rem;
  }

  @media (max-width: 600px) {
    .metrics-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--cyan);
  }

  .metric-label {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* Section Common */
  .section {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
  }

  .section-header {
    text-align: left;
    margin-bottom: 2.5rem;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-title {
    font-size: 1.85rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .section-more {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--cyan);
    font-weight: 600;
    font-size: 0.92rem;
    padding: 0.55rem 1.25rem;
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: var(--radius-full);
    background: rgba(0, 240, 255, 0.05);
    transition: all 0.25s ease;
  }

  .more-link:hover {
    background: rgba(0, 240, 255, 0.15);
    border-color: var(--cyan);
    transform: translateY(-2px);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.25);
  }

  .arrow-right {
    width: 16px;
    height: 16px;
  }

  /* Featured Tool */
  .featured-tool-wrapper {
    max-width: 860px;
    margin: 0 auto;
  }

  /* Blog Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 1040px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* BBS Res Form Card */
  .bbs-form-card {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem;
    border-left: 3px solid var(--green-2ch);
    background: linear-gradient(180deg, rgba(14, 22, 38, 0.85) 0%, rgba(8, 12, 20, 0.95) 100%);
  }

  .bbs-form-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.25rem;
  }

  .bbs-sage-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
  }

  .bbs-form-fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bbs-input-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 600px) {
    .bbs-input-row {
      grid-template-columns: 1fr;
    }
  }

  .bbs-field-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bbs-field-label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-secondary);
    white-space: nowrap;
    min-width: 50px;
  }

  .bbs-input {
    flex: 1;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.75rem;
    color: var(--green-2ch);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .bbs-textarea {
    width: 100%;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    color: #fff;
    font-size: 0.92rem;
    line-height: 1.6;
    resize: vertical;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .bbs-textarea:focus {
    border-color: var(--cyan);
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.2);
  }

  .bbs-form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .bbs-form-note {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-top: 0.5rem;
  }

  /* About Teaser */
  .about-card {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem;
  }

  .about-grid {
