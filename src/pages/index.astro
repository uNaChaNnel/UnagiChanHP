---
import Layout from '../layouts/Layout.astro';
import { toolsData } from '../data/tools';

const noteUrl = "https://note.com/un4chan";
const xUrl = "https://x.com/UnagiChaaaaaN";
const kakuyomuUrl = "https://kakuyomu.jp/users/UnagiChan";
const stampCreatorUrl = "https://stampcreator.unagichan.com/";
---

<Layout
  title="UNAGI LAB | うなぎちゃん公式ポートフォリオ（新GPU獲得泥水パイプライン）"
  description="AIイラストにハマりPCスペック限界突破！新GPU購入のため、嫁（あなごちゃん）の鉄壁ガードに挑みながらあらゆる収益化（Fanvue、note、FANZA同人、ツール開発、Game制作）の泥水を啜るプロ駄作クリエーターの公式ポートフォリオ。"
  compactFooter={false}
>
  <!-- Global System Telemetry Bar (Linear / Stripe style status) -->
  <aside class="enterprise-telemetry-bar" aria-label="UNAGI Enterprise リアルタイム稼働テレメトリ">
    <div class="telemetry-inner">
      <div class="telemetry-status-group">
        <span class="status-pulse-dot"></span>
        <span class="telemetry-label">UNAGI PORTFOLIO OS v2.5</span>
        <span class="telemetry-pill live">OPERATIONAL</span>
      </div>
      <div class="telemetry-metrics">
        <span class="metric-segment">
          <span class="m-key">UPTIME</span>
          <span class="m-val text-success">99.99%</span>
        </span>
        <span class="telemetry-sep">/</span>
        <span class="metric-segment">
          <span class="m-key">VRAM ALLOCATION</span>
          <span class="m-val text-alert">0.01% [CRITICAL]</span>
        </span>
        <span class="telemetry-sep">/</span>
        <span class="metric-segment">
          <span class="m-key">WIFE DEFENSE</span>
          <span class="m-val text-danger">99,999 [IRON WALL]</span>
        </span>
        <span class="telemetry-sep">/</span>
        <span class="metric-segment">
          <span class="m-key">GPU FUND</span>
          <span class="m-val text-success">泥水抽出中</span>
        </span>
        <span class="telemetry-sep">/</span>
        <span class="metric-segment cli-hint">
          <span class="m-key">CLI SHORTCUT</span>
          <span class="m-val">Type <code>unagi</code></span>
        </span>
      </div>
    </div>
  </aside>

  <!-- Ambient Backdrop Container -->
  <div class="portfolio-page" id="enterpriseViewport">
    <!-- Ambient Conic Spotlight & Linear Grid -->
    <div class="spotlight-layer" aria-hidden="true"></div>
    <div class="linear-grid-bg" aria-hidden="true"></div>

    <!-- Background Unagi Character Backdrop (Cardの後ろにうっすら配置 / Unveil Modeで全面表示) -->
    <div class="unagi-backdrop-layer" id="unagiBackdrop" aria-hidden="true">
      <div class="unagi-backdrop-glow"></div>
      <img src="/unagi-bg.png" alt="うなぎちゃん" class="unagi-backdrop-img" width="706" height="1024" />

      <!-- 股間の光っている部分にジャスト配置される RESTORE UI ボタン -->
      <div class="groin-restore-wrapper">
        <button id="restoreUiBtn" class="restore-ui-btn groin-btn" type="button" aria-label="元のカードUIを復元">
          <span class="groin-rainbow-pulse"></span>
          <span class="restore-icon">↺</span>
          <span class="restore-text">RESTORE UI</span>
        </button>
      </div>
    </div>

    <!-- Unveil Mode Floating Controls (下端メッセージボックス) -->
    <div class="unveil-controls" id="unveilControls" aria-hidden="true">
      <div class="unveil-banner">
        <span class="unveil-title">うなぎちゃん（真の姿）が顕現しました</span>
      </div>
    </div>

    <!-- Main Content Flow (Scrollable Portfolio) -->
    <div class="container portfolio-container" id="bentoLayout">

      <!-- ===================================================================
           HERO SECTION: Core Mission Control & Telemetry
           =================================================================== -->
      <section class="portfolio-hero cyber-card" aria-label="UNAGI Core Platform & Mission">
        <div class="card-glass-shine"></div>
        
        <div class="hero-top-row">
          <div class="enterprise-badge-pill">
            <span class="badge-sparkle">✦</span>
            <span class="badge-text">Official Creator Portfolio &amp; GPU Fund</span>
            <span class="badge-divider"></span>
            <span class="badge-sub">Wife Compliance: 0.001%</span>
          </div>
          <div class="kernel-id">KERNEL: DOROMIZU-6.12-PRO</div>
        </div>

        <h1 class="hero-headline">
          The Creator Portfolio for<br />
          <span class="gradient-headline">GPU Acquisition &amp; 泥水啜り.</span>
        </h1>

        <p class="hero-lead-text">
          漫画やゲームが大好きだったが、子供が生まれ趣味の時間が激減。スキマ時間に始めたAIイラストに見事どっぷりハマり、ローカル環境を構築するもPCスペックが限界突破。<br class="break-pc" />
          嫁（あなごちゃん）におねだりしたら秒殺されたプロ駄作クリエーターの全技術・制作物・泥水収益化挑戦ログを集約。<br class="break-pc" />
          <strong class="gpu-roar">今日もGPUを唸らせる・・・‼‼　ｳｫｫｫｫｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰﾝ‼‼‼‼‼</strong>
        </p>

        <!-- KPI Grid -->
        <div class="hero-kpi-grid">
          <div class="kpi-cell">
            <span class="kpi-title">GPU VRAM REMAINING</span>
            <div class="kpi-number text-alert">0.02%</div>
            <span class="kpi-sub">限界突破・煙出そう</span>
          </div>
          <div class="kpi-cell">
            <span class="kpi-title">MONETIZATION CHANNELS</span>
            <div class="kpi-number text-cyan">5+ 項目</div>
            <span class="kpi-sub">泥水啜って全力挑戦中</span>
          </div>
          <div class="kpi-cell">
            <span class="kpi-title">BOREDOM TOLERANCE</span>
            <div class="kpi-number text-green">0.00%</div>
            <span class="kpi-sub">面白くないなら即撤退</span>
          </div>
        </div>

        <!-- Quick Jump Navigation -->
        <div class="hero-quick-nav">
          <a href="#works" class="cyber-btn cyber-btn-primary quick-btn">
            <span class="btn-icon">🛠️</span>
            <span>制作物・ツール</span>
          </a>
          <a href="#monetization" class="cyber-btn quick-btn highlight-btn">
            <span class="btn-icon">💰</span>
            <span>収益化挑戦パイプライン</span>
          </a>
          <a href="#platforms" class="cyber-btn quick-btn">
            <span class="btn-icon">📡</span>
            <span>活動拠点・SNS</span>
          </a>
          <button id="heroCliBtn" class="cyber-btn quick-btn cli-quick-btn" type="button">
            <span class="btn-icon">&gt;_</span>
            <span>CLI起動</span>
          </button>
        </div>
      </section>

      <!-- ===================================================================
           SECTION 1: 制作物・Webツール開発 (WORKS & PRODUCTS)
           =================================================================== -->
      <section class="portfolio-section" id="works" aria-label="制作物・自作Webツール">
        <div class="section-header-row">
          <div class="section-title-wrap">
            <span class="section-badge cyan">01 // WORKS &amp; PRODUCTS</span>
            <h2 class="section-title">制作物・Webツール開発</h2>
            <p class="section-desc">
              クリエイターの面倒な手作業や規格調整を一撃で解決する、完全ブラウザ完結の自作Webアプリケーション。
            </p>
          </div>
          <a href="/tools" class="section-more-link">
            すべてのツールを見る ➔
          </a>
        </div>

        <div class="works-grid">
          <!-- StampCreator: Flagship -->
          <article class="work-card featured-work cyber-card">
            <div class="card-glow-edge cyan"></div>
            <div class="work-header">
              <div class="work-status-badge cyan">
                <span class="pulse-dot"></span>
                <span>FLAGSHIP TOOL // ACTIVE</span>
              </div>
              <span class="work-price-pill">完全無料 // 0円</span>
            </div>

            <div class="work-body">
              <h3 class="work-title">
                <a href={stampCreatorUrl} target="_blank" rel="noopener noreferrer">
                  StampCreator ➔
                </a>
              </h3>
              <p class="work-catchphrase">
                LINEスタンプ クイックメーカー - スマホ完結・規格準拠画像セット一括生成
              </p>
              <p class="work-desc">
                スマホやPCのブラウザだけで完結。イラスト画像をアップロードするだけで、LINE Creators Marketの厳格な「偶数ドット規格・サイズ・余白ルール」に自動適合し、メイン・タブ・スタンプ画像をZIPで即座に一括生成できる制作支援Webツールです。
              </p>

              <div class="work-features-list">
                <div class="feat-item">✓ LINE Creators Market 公式規格に完全自動準拠</div>
                <div class="feat-item">✓ メイン画像(240×240)・タブ画像(96×74)・スタンプ画像(最大370×320)を自動作成</div>
                <div class="feat-item">✓ 完全クライアント処理（サーバー通信ゼロ・画像データ流出なし）</div>
                <div class="feat-item">✓ スマホのブラウザでも軽快に動作する直感UI</div>
              </div>
            </div>

            <div class="work-footer">
              <a href={stampCreatorUrl} target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-primary">
                StampCreatorを起動する ➔
              </a>
              <a href="/tools" class="cyber-btn">
                詳細・仕様解説
              </a>
            </div>
          </article>

          <!-- Side Works Column -->
          <div class="side-works-column">
            <!-- UNAGI Official Portal -->
            <article class="work-card cyber-card">
              <div class="work-header">
                <div class="work-status-badge green">
                  <span class="pulse-dot green"></span>
                  <span>CORE INFRA // LIVE</span>
                </div>
                <span class="tech-tag">Astro v5 + Cloudflare</span>
              </div>
              <div class="work-body">
                <h3 class="work-title">
                  <a href="/">うなぎちゃん公式サイト（本ポータル）</a>
                </h3>
                <p class="work-desc">
                  Cloudflare Pages × Astroによる爆速SSGポータル。Zero-JS設計、PageSpeed Insights満点、サイバーCUIターミナルエミュレータを完全自作搭載。
                </p>
              </div>
              <div class="work-footer">
                <span class="work-spec-text">Zero-JS / SSG / Edge Cache</span>
              </div>
            </article>

            <!-- 案くれ (Idea Wanted) -->
            <article class="work-card cyber-card">
              <div class="work-header">
                <div class="work-status-badge pink">
                  <span class="pulse-dot pink"></span>
                  <span>IDEA WANTED // 案くれ</span>
                </div>
                <span class="tech-tag">企画構想中</span>
              </div>
              <div class="work-body">
                <h3 class="work-title">
                  <a href="/tools">スタンプ用プロンプトラボ（案くれ）</a>
                </h3>
                <p class="work-desc">
                  股間が虹色に光るうなぎちゃん誕生。LINEスタンプ制作に役立つセリフ・ポーズの一括プロンプト生成ツールを構想中。クリエイターからのアイデアを大募集中！
                </p>
              </div>
              <div class="work-footer">
                <a href="/tools" class="link-arrow pink">
                  アイデア提案・詳細 ➔
                </a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- ===================================================================
           SECTION 2: 収益化現在挑戦中パイプライン (MONETIZATION ROADMAP)
           =================================================================== -->
      <section class="portfolio-section" id="monetization" aria-label="新GPU獲得に向けた収益化挑戦パイプライン">
        <div class="section-header-row">
          <div class="section-title-wrap">
            <span class="section-badge purple">02 // GPU FUND PIPELINE</span>
            <h2 class="section-title">新GPU獲得！収益化現在挑戦中</h2>
            <p class="section-desc">
              嫁（あなごちゃん）にグラボ代を秒殺された男が、最新ハイスペックGPU購入資金を錬成するために泥水を啜って挑戦しているリアルタイム進捗ログ。
            </p>
          </div>
        </div>

        <div class="pipeline-grid">
          <!-- 1. Fanvue -->
          <div class="pipeline-card cyber-card border-green">
            <div class="pipeline-card-glow green"></div>
            <div class="pipeline-top">
              <span class="pipeline-status-badge status-active">
                <span class="status-pulse-dot green"></span>
                <span>収益化達成 // ACTIVE</span>
              </span>
              <span class="pipeline-tag">ファンコミュニティ</span>
            </div>
            <h3 class="pipeline-card-title">Fanvue</h3>
            <p class="pipeline-card-desc">
              AIイラスト生成技術を活かしたファンコミュニティ運営・コンテンツ配信。収益化を達成し、新GPU購入資金の貴重な兵站として現在進行形で稼働中！
            </p>
            <div class="pipeline-card-footer">
              <span class="pipeline-meta">Status: 稼働中・継続投稿</span>
            </div>
          </div>

          <!-- 2. note販売 -->
          <div class="pipeline-card cyber-card border-green">
            <div class="pipeline-card-glow green"></div>
            <div class="pipeline-top">
              <span class="pipeline-status-badge status-active">
                <span class="status-pulse-dot green"></span>
                <span>有料記事売上発生 // SUCCESS</span>
              </span>
              <span class="pipeline-tag">コンテンツ販売</span>
            </div>
            <h3 class="pipeline-card-title">
              <a href={noteUrl} target="_blank" rel="noopener noreferrer">
                note 有料記事販売 ➔
              </a>
            </h3>
            <p class="pipeline-card-desc">
              「嫁にグラボを一蹴されたプロ駄作クリエーターの奮闘記」や開発・創作ノウハウを公開。有料記事が実際に数本売れ、泥水から最初の一滴を抽出成功！
            </p>
            <div class="pipeline-card-footer">
              <a href={noteUrl} target="_blank" rel="noopener noreferrer" class="link-arrow green">
                noteを見に行く ➔
              </a>
            </div>
          </div>

          <!-- 3. FANZA同人CG販売 -->
          <div class="pipeline-card cyber-card border-yellow">
            <div class="pipeline-card-glow yellow"></div>
            <div class="pipeline-top">
              <span class="pipeline-status-badge status-review">
                <span class="status-pulse-dot yellow"></span>
                <span>審査中 // UNDER REVIEW</span>
              </span>
              <span class="pipeline-tag">同人CG・写真集</span>
            </div>
            <h3 class="pipeline-card-title">FANZA同人等でのCG販売</h3>
            <p class="pipeline-card-desc">
              AIイラストを活用した同人CG集・デジタル作品集の販売申請中。審査が無事に通ればグラボ獲得に向けた特大の前進！現在審査通過を祈祷中。
            </p>
            <div class="pipeline-card-footer">
              <span class="pipeline-meta text-yellow">Status: 審査結果待ち</span>
            </div>
          </div>

          <!-- 4. AIデジタル商品 -->
          <div class="pipeline-card cyber-card border-purple">
            <div class="pipeline-card-glow purple"></div>
            <div class="pipeline-top">
              <span class="pipeline-status-badge status-ready">
                <span class="status-pulse-dot purple"></span>
                <span>準備完了 // PLATFORM PENDING</span>
              </span>
              <span class="pipeline-tag">デジタルアセット</span>
            </div>
            <h3 class="pipeline-card-title">AIデジタル商品</h3>
            <p class="pipeline-card-desc">
              高精度プロンプト集やデジタル制作アセットのパッケージングは完了。配信プラットフォーム側の準備が整い次第即時ローンチ予定。
            </p>
            <div class="pipeline-card-footer">
              <span class="pipeline-meta text-purple">Status: プラットフォーム準備待ち</span>
            </div>
          </div>

          <!-- 5. Game作成 -->
          <div class="pipeline-card cyber-card border-cyan">
            <div class="pipeline-card-glow cyan"></div>
            <div class="pipeline-top">
              <span class="pipeline-status-badge status-wip">
                <span class="status-pulse-dot cyan"></span>
                <span>まったり作成中 // IN PROGRESS</span>
              </span>
              <span class="pipeline-tag">ゲーム開発</span>
            </div>
            <h3 class="pipeline-card-title">自作Game作成</h3>
            <p class="pipeline-card-desc">
              漫画・ゲーム好きとしての情熱を結集。「面白くないならやらない」の精神で、自分が本気で遊べる世界観のゲームを気ままに試作・開発中。
            </p>
            <div class="pipeline-card-footer">
              <span class="pipeline-meta text-cyan">Status: プロトタイプ開発中</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================================================================
           SECTION 3: 元々やっていること & 活動拠点 (PLATFORMS & ORIGINS)
           =================================================================== -->
      <section class="portfolio-section" id="platforms" aria-label="元々やっている創作活動とプラットフォーム">
        <div class="section-header-row">
          <div class="section-title-wrap">
            <span class="section-badge green">03 // ORIGINS &amp; PLATFORMS</span>
            <h2 class="section-title">元々やっていること &amp; 活動拠点</h2>
            <p class="section-desc">
              うなぎちゃんが元々活動している創作のフロントライン、発信拠点、ストーリー創作の原点。
            </p>
          </div>
        </div>

        <div class="platforms-grid">
          <!-- X (Twitter) -->
          <a href={xUrl} target="_blank" rel="noopener noreferrer" class="platform-card cyber-card">
            <div class="platform-icon-wrap">
              <svg class="platform-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </div>
            <div class="platform-body">
              <div class="platform-badge-row">
                <span class="platform-badge">OFFICIAL SNS</span>
                <span class="platform-handle">@UnagiChaaaaaN</span>
              </div>
              <h3 class="platform-title">X (旧Twitter)</h3>
              <p class="platform-desc">
                日々のAIイラスト生成、ツール開発進捗、日常、そして嫁（あなごちゃん）との熾烈な交渉ログを日々ポストしている全活動の最前線。
              </p>
            </div>
            <div class="platform-arrow">➔</div>
          </a>

          <!-- カクヨム -->
          <a href={kakuyomuUrl} target="_blank" rel="noopener noreferrer" class="platform-card cyber-card">
            <div class="platform-icon-wrap kakuyomu-icon">
              <span class="icon-letter">K</span>
            </div>
            <div class="platform-body">
              <div class="platform-badge-row">
                <span class="platform-badge">NOVEL &amp; STORY</span>
                <span class="platform-handle">UnagiChan</span>
              </div>
              <h3 class="platform-title">カクヨム</h3>
              <p class="platform-desc">
                Web小説執筆・ストーリー創作活動の拠点。物語を作ることへの情熱を注ぎ込む、文章クリエイターとしての原点。
              </p>
            </div>
            <div class="platform-arrow">➔</div>
          </a>

          <!-- note -->
          <a href={noteUrl} target="_blank" rel="noopener noreferrer" class="platform-card cyber-card">
            <div class="platform-icon-wrap note-icon">
              <span class="icon-letter">n</span>
            </div>
            <div class="platform-body">
              <div class="platform-badge-row">
                <span class="platform-badge">TECH &amp; ESSAY</span>
                <span class="platform-handle">un4chan</span>
              </div>
              <h3 class="platform-title">公式note</h3>
              <p class="platform-desc">
                「嫁にグラボを一蹴されたプロ駄作クリエーターの奮闘記」や開発ログ、AI活用ノウハウを発信。有料記事も好評展開中！
              </p>
            </div>
            <div class="platform-arrow">➔</div>
          </a>
        </div>
      </section>

      <!-- ===================================================================
           SECTION 4: クリエイタースペック & 秘密連絡網 (PROFILE & CONTACT)
           =================================================================== -->
      <section class="portfolio-section" id="profile" aria-label="クリエイタースペックと連絡先">
        <div class="creator-profile-card cyber-card">
          <div class="profile-glow"></div>
          
          <div class="profile-content-wrap">
            <div class="profile-avatar-wrap">
              <img src="/unagi-icon.png" alt="うなぎちゃん" class="profile-avatar-img" width="100" height="100" />
            </div>

            <div class="profile-info-body">
              <div class="profile-badge-row">
                <span class="cyber-badge pink">CREATOR SPEC</span>
                <span class="spec-id">ID: UNAGI-001</span>
              </div>

              <h2 class="profile-title">うなぎちゃん＠（プロ駄作クリエーター）</h2>
              
              <div class="concept-callout-box">
                <strong>グラボほちい・・・泥水啜って頑張ります。<br />※楽しくなさそうなことはやりません。</strong>
              </div>

              <p class="profile-bio">
                「色んな事をやりたい。でも面白くないならやらない」人間。長年のエンジニア経験を活かし、制御・組み込みからモダンWeb、AI活用、小説創作まで面白い事だけに計算資源をフル投入しています。
              </p>

              <div class="skills-tag-row">
                <span class="spec-tag highlight">C# / WPF</span>
                <span class="spec-tag highlight">C / C++</span>
                <span class="spec-tag highlight">MATLAB / Simulink</span>
                <span class="spec-tag">TypeScript</span>
                <span class="spec-tag">Astro</span>
                <span class="spec-tag">Canvas API</span>
                <span class="spec-tag doromizu">泥水耐性: MAX</span>
              </div>

              <div class="profile-actions-row">
                <a href="/about" class="cyber-btn cyber-btn-primary">
