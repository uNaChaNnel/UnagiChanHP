---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-logo">
          <img src="/unagi-icon.png" alt="うなぎちゃん" class="footer-logo-img" width="32" height="32" />
          <span class="gradient-text logo-title">うなぎちゃんねる</span>
          <span class="cyber-badge purple">uNaChaNnel BBS</span>
        </div>
        <p class="brand-desc">
          「面倒な作業は全部ツールにやらせたい」という一心で個人開発を続けるうなぎちゃんの公式ポータル。
          たまにバグが出ても温かい目で見守ってください。
        </p>
        <div class="social-links">
          <a
            href="https://x.com/UnagiChaaaaaN"
            target="_blank"
            rel="noopener noreferrer"
            class="social-btn"
            aria-label="X (Twitter) @UnagiChaaaaaN"
          >
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span>X: @UnagiChaaaaaN</span>
          </a>
        </div>
      </div>

      <div class="footer-nav-groups">
        <div class="nav-group">
          <h4 class="nav-heading">TOOLS / 制作ツール</h4>
          <ul>
            <li><a href="https://stampcreator.unagichan.com/" target="_blank" rel="noopener noreferrer">StampCreator</a></li>
            <li><a href="/tools">制作ツール一覧</a></li>
          </ul>
        </div>

        <div class="nav-group">
          <h4 class="nav-heading">INSIGHTS / 開発ノート</h4>
          <ul>
            <li><a href="/blog">公式ブログ</a></li>
            <li><a href="/about">プロフィール</a></li>
            <li><a href="/contact">お問い合わせ</a></li>
          </ul>
        </div>

        <div class="nav-group">
          <h4 class="nav-heading">LEGAL / 規約・方針</h4>
          <ul>
            <li><a href="/privacy-policy">プライバシーポリシー</a></li>
            <li><a href="/disclaimer">免責事項</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} うなぎちゃん (UnagiChaaaaaN). All rights reserved.
      </p>
      <p class="powered-by">
        Powered by Astro &amp; Cloudflare Pages
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: rgba(4, 6, 10, 0.95);
    border-top: 1px solid var(--border-subtle);
    padding-top: 4rem;
    padding-bottom: 2.5rem;
    position: relative;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.3), transparent);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .footer-top {
      grid-template-columns: 1.4fr 2fr;
      gap: 4rem;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-logo-img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(0, 240, 255, 0.4);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
    object-fit: cover;
  }

  .logo-title {
    font-size: 1.35rem;
    font-weight: 700;
  }

  .brand-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
    max-width: 440px;
  }

  .social-links {
    margin-top: 0.5rem;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    color: var(--text-main);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  .social-btn:hover {
    background: rgba(0, 240, 255, 0.1);
    border-color: var(--cyan);
    color: #fff;
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.2);
  }

  .social-btn .icon {
    width: 14px;
    height: 14px;
  }

  .footer-nav-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 2rem;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-heading {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--cyan);
    letter-spacing: 0.08em;
  }

  .nav-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .nav-group a {
    color: var(--text-secondary);
    font-size: 0.88rem;
    transition: all 0.2s ease;
  }

  .nav-group a:hover {
    color: #fff;
    padding-left: 4px;
    color: var(--cyan);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
    }
  }

  .powered-by {
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
