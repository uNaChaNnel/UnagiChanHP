---
interface Props {
  slotId?: string;
  format?: 'auto' | 'fluid' | 'rectangle';
  responsive?: boolean;
  className?: string;
}

const {
  slotId = '0000000000',
  format = 'auto',
  responsive = true,
  className = '',
} = Astro.props;

// クライアントID（環境変数 または 定数）。審査通過後に自身のパブリッシャーID（ca-pub-XXXXXXXXXXXX）を設定可能
const publisherId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || '';
const isConfigured = Boolean(publisherId && publisherId !== 'ca-pub-XXXXXXXXXXXXXXXX');
---

<div class={`adsense-wrapper my-8 ${className}`}>
  {isConfigured ? (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={publisherId}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-full-width-responsive={responsive ? 'true' : 'false'}
    ></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  ) : (
    <div class="ad-placeholder">
      <div class="ad-tag">SPONSORED / 広告枠</div>
      <p class="ad-note">Google AdSense 掲載スロット（審査通過後に自動反映）</p>
    </div>
  )}
</div>

<style>
  .adsense-wrapper {
    margin: 2rem 0;
    min-height: 100px;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    overflow: hidden;
  }

  .ad-placeholder {
    width: 100%;
    max-width: 728px;
    height: 90px;
    border: 1px dashed rgba(0, 240, 255, 0.25);
    background: rgba(10, 16, 28, 0.4);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    user-select: none;
  }

  .ad-tag {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--cyan);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .ad-note {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }
</style>
