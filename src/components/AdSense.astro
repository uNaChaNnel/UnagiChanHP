---
/**
 * Google AdSense Component
 * ※ 現在は「自動広告（Auto Ads）」のみで運用しているため、
 * Layout.astro のヘッダーにて一元配信されています。
 * 将来的に個別広告ユニット（手動スロット）を設置する場合に備えてコンポーネントを維持しています。
 */
interface Props {
  slotId?: string;
  format?: 'auto' | 'fluid' | 'rectangle';
  responsive?: boolean;
  className?: string;
  enableManualSlot?: boolean;
}

const {
  slotId = '',
  format = 'auto',
  responsive = true,
  className = '',
  enableManualSlot = false,
} = Astro.props;

const publisherId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || 'ca-pub-9242439217321222';
---

{enableManualSlot && slotId && (
  <div class={`adsense-wrapper my-8 ${className}`}>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={publisherId}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-full-width-responsive={responsive ? 'true' : 'false'}
    ></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}

<style>
  .adsense-wrapper {
    margin: 2rem 0;
    min-height: 100px;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    overflow: hidden;
  }
</style>
