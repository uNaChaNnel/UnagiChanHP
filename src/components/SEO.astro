---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
}

const {
  title = 'うなぎちゃん公式サイト | クリエイター＆開発スタジオ',
  description = 'うなぎちゃん（@UnagiChaaaaaN）の公式サイト。LINEスタンプ制作支援ツール「StampCreator」をはじめとするWebツール一覧や、開発・制作ノウハウをお届けするブログを掲載しています。',
  image = '/og-image.png',
  canonicalURL = Astro.url.href,
  type = 'website',
} = Astro.props;

const siteTitle = title.includes('うなぎちゃん') ? title : `${title} | うなぎちゃん公式サイト`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site || 'https://unagichan.com')} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site || 'https://unagichan.com')} />
<meta name="twitter:creator" content="@UnagiChaaaaaN" />
<meta name="twitter:site" content="@UnagiChaaaaaN" />
